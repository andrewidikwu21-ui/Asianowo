---
import siteData from '../data/site';
import { buildWhatsAppUrl } from '../utils/whatsapp';

const whatsappUrl = buildWhatsAppUrl(
  siteData.contact.whatsappNumber,
  siteData.messages.consultation
);
---

<aside
  id="sticky-mobile-bar"
  class="md:hidden fixed bottom-0 left-0 right-0 z-50 p-3 bg-[var(--background)]/95 backdrop-blur-sm border-t border-[var(--outline-variant)]/60 transition-transform duration-300 ease-in-out translate-y-full pointer-events-none"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
  aria-label="Quick booking bar"
>
  <a
    href={whatsappUrl}
    id="sticky-whatsapp-btn"
    target="_blank"
    rel="noopener noreferrer"
    data-wa-location="sticky-bar"
    class="tap-target w-full flex items-center justify-center gap-2 py-3.5 px-4 bg-[var(--primary)] text-white text-[16px] font-medium tracking-wide shadow-md active:opacity-95"
  >
    <!-- WhatsApp Simple Clean SVG Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <span>Book on WhatsApp</span>
  </a>
</aside>
