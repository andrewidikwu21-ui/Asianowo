---
import { Image } from 'astro:assets';
import type { ProjectItem } from '../data/site';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;

/**
 * CLIENT PRIVACY & CONSENT REMINDER:
 * 1. Hard Rule: NO client faces and NO identifying details (street names, house numbers,
 *    name tags, visible addresses) may ever appear in any photo.
 * 2. Only post project photos with explicit, written client consent (WhatsApp "YES" reply).
 */
---

<div class="ba-card bg-transparent">
  <!-- Interactive slider (when JS is active) -->
  <div
    class="ba-slider relative aspect-[4/3] w-full overflow-hidden bg-[var(--background)] border border-[var(--outline-variant)] select-none"
    data-ba-slider
    style="--pos: 50%;"
  >
    <!-- AFTER Image (Underneath) -->
    <div class="absolute inset-0 w-full h-full">
      <Image
        src={project.afterImage}
        alt={project.afterAlt}
        width={800}
        height={600}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover select-none pointer-events-none"
      />
      <span class="absolute top-3 right-3 bg-[var(--secondary-container)] text-[var(--on-secondary-container)] text-[12px] font-medium tracking-wider uppercase px-2.5 py-1 select-none pointer-events-none z-10">
        After
      </span>
    </div>

    <!-- BEFORE Image (Clipped Overlay) -->
    <div
      class="ba-overlay absolute inset-0 w-full h-full pointer-events-none"
      style="clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0);"
    >
      <Image
        src={project.beforeImage}
        alt={project.beforeAlt}
        width={800}
        height={600}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover select-none pointer-events-none"
      />
      <span class="absolute top-3 left-3 bg-[var(--primary-container)] text-[var(--on-primary-container)] text-[12px] font-medium tracking-wider uppercase px-2.5 py-1 select-none pointer-events-none z-10">
        Before
      </span>
    </div>

    <!-- Divider Line -->
    <div
      class="ba-divider absolute top-0 bottom-0 w-[2px] bg-white shadow-[0_0_8px_rgba(0,0,0,0.4)] pointer-events-none z-20"
      style="left: var(--pos, 50%); transform: translateX(-50%);"
    ></div>

    <!-- Draggable Knob Icon -->
    <div
      class="ba-knob absolute top-1/2 w-10 h-10 -mt-5 -ml-5 rounded-full bg-[var(--primary)] text-white border-2 border-white flex items-center justify-center shadow-lg pointer-events-none z-20"
      style="left: var(--pos, 50%);"
      aria-hidden="true"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
        <polyline points="9 18 15 12 9 6" transform="translate(24, 0) scale(-1, 1)"></polyline>
      </svg>
    </div>

    <!-- Range Input for Touch, Mouse Drag & Keyboard Access (Left/Right Arrows) -->
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label={`Comparison slider: ${project.caption}`}
      class="ba-range-input absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30 m-0 p-0"
    />
  </div>

  <!-- Fallback for No-JavaScript (Stacked Images) -->
  <noscript>
    <div class="space-y-3 mt-2">
      <div class="relative">
        <span class="absolute top-2 left-2 bg-[var(--primary-container)] text-[var(--on-primary-container)] text-[12px] font-medium px-2 py-0.5 z-10">
          Before
        </span>
        <Image
          src={project.beforeImage}
          alt={project.beforeAlt}
          width={800}
          height={600}
          class="w-full aspect-[4/3] object-cover"
        />
      </div>
      <div class="relative">
        <span class="absolute top-2 left-2 bg-[var(--secondary-container)] text-[var(--on-secondary-container)] text-[12px] font-medium px-2 py-0.5 z-10">
          After
        </span>
        <Image
          src={project.afterImage}
          alt={project.afterAlt}
          width={800}
          height={600}
          class="w-full aspect-[4/3] object-cover"
        />
      </div>
    </div>
  </noscript>

  <!-- Caption: [PLACEHOLDER] Project type, area. Duration. -->
  <p class="mt-3 text-[14px] text-[var(--on-surface-variant)] leading-snug">
    {project.caption.includes('[PLACEHOLDER]') ? (
      <span class="placeholder-text">{project.caption}</span>
    ) : (
      <span>{project.caption}</span>
    )}
  </p>
</div>
