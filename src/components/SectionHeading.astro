---
interface Props {
  tag?: 'h1' | 'h2' | 'h3';
  script?: boolean;
  class?: string;
  id?: string;
}

const {
  tag: Tag = 'h2',
  script = false,
  class: className = '',
  id,
} = Astro.props;
---

<Tag
  id={id}
  class={`${script ? 'font-display-title text-[40px] sm:text-[46px] md:text-[56px] text-[var(--primary)] font-normal tracking-tight' : 'font-body text-[26px] sm:text-[30px] md:text-[34px] font-medium text-[var(--primary)] tracking-tight leading-tight'} ${className}`}
>
  <slot />
</Tag>
